node_modules/
package-lock.json.bak

# Rendered frames are regenerable; the episode and the film are not.
series/*/episodes/*/frames/
series/*/reels/*/frames/
series/*/reels/*/reel.json
# An episode's compiled scene, and the frame stills of a cut-down.
series/*/episodes/*/frames/
series/*/episodes/*/episode.json

# Scratch output
projects/*/preview/tmp/
*.log
.DS_Store
.env

# Workbook lock files created by Excel while open
~$*.xlsx
content/.~lock.*

# A reel's encoded film is a build artefact, and it is big. Key-frame sheets and
# the stills that go in the docs are committed; the mp4 is regenerated with
#   node tools/render-reel.mjs --reel r03 --all --mp4 <path>
series/*/reels/*/output/*.mp4
# Except a film that has been approved and handed over. A gitignored render does
# not survive a fresh checkout, and "where is the video" is not a question the
# repo should be able to lose the answer to.
!series/your-data-explained/reels/r03-why-the-ad-follows-you/output/r03-why-the-ad-follows-you.mp4

# Long-form episodes follow the same rule: the intermediate render is a build
# artefact, the delivered film is not.
series/*/episodes/*/output/*.mp4
!series/ai-without-the-hype/episodes/0102-how-ai-automation-actually-works/output/0102-how-ai-automation-actually-works.mp4

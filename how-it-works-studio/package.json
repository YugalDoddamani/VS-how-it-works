{
  "name": "how-it-works-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Render illustrated isometric technology explainers, authored in a spreadsheet, presented by an anime character with text-driven lip-sync.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "studio": "src/cli.js"
  },
  "scripts": {
    "doctor": "node src/cli.js doctor",
    "list": "node src/cli.js list",
    "new": "node src/cli.js new",
    "sheet:check": "python3 tools/check_content.py",
    "sheet:build": "python3 tools/build-sheet.py",
    "sheet:export": "python3 tools/build-sheet.py",
    "sheet:pull": "node src/cli.js sheet-pull",
    "gallery": "node src/cli.js gallery",
    "preview": "node src/cli.js preview",
    "check": "node src/cli.js check",
    "render": "node src/cli.js render",
    "verify": "node src/cli.js verify",
    "build": "node src/cli.js build",
    "publish": "node src/cli.js publish",
    "determinism": "node src/cli.js determinism",
    "clean": "node src/cli.js clean",
    "test": "node --test \"test/**/*.test.js\"",
    "content:check": "python3 tools/check_content.py",
    "projects:build": "node tools/build-projects.mjs",
    "content:strict": "python3 tools/check_content.py --strict",
    "reel:compile": "node tools/compile-reel.mjs",
    "reel:stills": "node tools/render-reel.mjs --stills 0,240,700",
    "reel:render": "node tools/render-reel.mjs --all --mp4 series/your-data-explained/reels/r03-why-the-ad-follows-you/output/r03-why-the-ad-follows-you.mp4",
    "reel:preview": "node tools/preview-server.mjs",
    "sprites": "python3 tools/build-nao-sprites.py",
    "episode:compile": "node tools/compile-episode.mjs",
    "episode:report": "node tools/compile-episode.mjs --report",
    "reels:collect": "node tools/collect-reels.mjs",
    "reels:check": "node tools/collect-reels.mjs --check"
  },
  "dependencies": {
    "playwright-core": "^1.64.1",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@napi-rs/canvas": "^1.0.13",
    "@sparticuz/chromium": "^153.0.0"
  }
}
